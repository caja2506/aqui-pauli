rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserRole() {
      return get(/databases/$(database)/documents/users_roles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // --- users_roles ---
    match /users_roles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'cliente';
      allow update, delete: if isAdmin();
    }

    // --- Catálogo público (lectura abierta) ---
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      match /variants/{variantId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /brands/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- Carrito (solo dueño) ---
    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }

    function ownsOrder(data) {
      return request.auth != null
        && (data.get('uid', '') == request.auth.uid || data.get('customerUid', '') == request.auth.uid);
    }

    function isTilopayOrder(data) {
      return data.get('paymentMethod', '') == 'tilopay' || data.keys().hasAny(['tilopay']);
    }

    function isCashOnDeliveryOrder(data) {
      return data.get('paymentMethod', '') == 'contra_entrega' || data.keys().hasAny(['cashOnDelivery']);
    }

    // El administrador puede gestionar entrega y notas, pero acreditar dinero o
    // cancelar requiere la transacción que consume o libera la reserva.
    function validCashOnDeliveryUpdate(before, after) {
      let cash = before.get('cashOnDelivery', {});
      let stages = { 'pendiente_pago': 0, 'por_preparar': 1, 'preparando': 2, 'enviado': 3, 'entregado': 4 };
      return before.status == after.status
        || (cash.get('version', 0) == 1
          && ((cash.get('state', '') == 'pending' && before.paymentStatus == 'pendiente')
            || (cash.get('state', '') == 'collected' && before.paymentStatus == 'pagado'))
          && before.status in ['pendiente_pago', 'por_preparar', 'preparando', 'enviado', 'entregado']
          && after.status in ['por_preparar', 'preparando', 'enviado', 'entregado']
          && stages[after.status] > stages[before.status]);
    }

    function validClientItem(data) {
      return data.keys().hasOnly([
          'productId', 'variantId', 'productName', 'variantName', 'imageUrl', 'price', 'quantity', 'supplyType', 'lineTotal'
        ])
        && data.productId is string && data.productId.matches('[A-Za-z0-9_-]{1,128}')
        && data.variantId is string && data.variantId.matches('[A-Za-z0-9_-]{1,128}')
        && data.quantity is int && data.quantity > 0 && data.quantity <= 99
        && data.price is number && data.price >= 0 && data.price <= 90071992547409
        && data.lineTotal is number && data.lineTotal >= 0 && data.lineTotal <= 90071992547409;
    }

    function unlockedItems(data) {
      return !isCashOnDeliveryOrder(data)
        && !data.keys().hasAny(['tilopay', 'inventoryReservation', 'fulfillment', 'discount', 'giftSample'])
        && data.get('paymentStatus', '') in ['pendiente', 'rechazado', 'verificando'];
    }

    // El servidor aplica inventario/CRM y pasa pagado a por_preparar. El navegador
    // solo puede avanzar una entrega cuya evidencia sigue vigente y sin revisión.
    function validTilopayFulfillmentUpdate(before, after) {
      let tilopay = before.get('tilopay', {});
      let paidKey = tilopay.get('paidAttemptKey', '');
      let attempt = tilopay.get('attemptsById', {}).get(paidKey, {});
      let fulfillment = before.get('fulfillment', {});
      return before.status == after.status
        || (before.get('paymentStatus', '') == 'pagado'
          && before.get('reconciliationResult', '') == 'tilopay_consult'
          && before.get('paymentTransactionId', '') != ''
          && tilopay.get('status', '') == 'approved'
          && tilopay.get('reconciliationNeedsReview', false) == false
          && tilopay.get('duplicatePaymentNeedsReview', false) == false
          && tilopay.get('legacyNeedsReview', false) == false
          && paidKey != ''
          && attempt.get('schemaVersion', 0) == 2
          && attempt.get('mode', '') == 'live' && attempt.get('status', '') == 'approved'
          && attempt.get('financialEvidence', '') == 'captured'
          && attempt.get('reconciliationNeedsReview', false) == false
          && attempt.get('idTilopay', '') == before.paymentTransactionId
          && fulfillment.get('version', 0) == 1 && fulfillment.get('state', '') == 'applied'
          && fulfillment.get('paidAttemptKey', '') == paidKey
          && fulfillment.get('paymentTransactionId', '') == before.paymentTransactionId
          && ((before.status == 'por_preparar' && after.status == 'enviado')
            || (before.status == 'enviado' && after.status == 'entregado')))
        || (!before.keys().hasAny(['tilopay', 'inventoryReservation'])
          && before.status == 'pendiente_pago' && before.paymentStatus == 'pendiente' && after.status == 'cancelado');
    }

    match /discountCodes/{code} { allow read, write: if isAdmin(); }
    match /discountBatches/{id} { allow read, write: if isAdmin(); }
    match /discountAttempts/{uid} { allow read, write: if false; }

    // --- Pedidos ---
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (isAdmin() || ownsOrder(resource.data));

      // Ni los admins de navegador crean pedidos pagados ni metadatos de pasarela.
      allow create: if false; // El callable calcula envío, mínimo y reserva desde catálogo.

      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'customerUid', 'promotionReceipt', 'discount', 'discountReleasedAt', 'subtotalBeforeDiscount', 'tilopay', 'cashOnDelivery', 'inventoryReservation', 'fulfillment', 'paidEffects', 'legacyReservationReleasedAt'
        ])
        && ((isAdmin()
            && ((!isTilopayOrder(resource.data) && !isTilopayOrder(request.resource.data)
                  && !isCashOnDeliveryOrder(resource.data) && !isCashOnDeliveryOrder(request.resource.data))
              || (isCashOnDeliveryOrder(resource.data) && isCashOnDeliveryOrder(request.resource.data)
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'notes', 'trackingNumber', 'trackingUrl', 'customerName', 'customerPhone', 'customerEmail', 'shippingAddress', 'updatedAt'])
                  && validCashOnDeliveryUpdate(resource.data, request.resource.data))
              || (!isCashOnDeliveryOrder(resource.data) && !isCashOnDeliveryOrder(request.resource.data)
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'notes', 'trackingNumber', 'trackingUrl', 'updatedAt'])
                  && validTilopayFulfillmentUpdate(resource.data, request.resource.data))))
          || (ownsOrder(resource.data)
            && resource.data.paymentStatus in ['pendiente', 'rechazado', 'verificando']
            && !isTilopayOrder(resource.data) && !isTilopayOrder(request.resource.data)
            && !isCashOnDeliveryOrder(resource.data) && !isCashOnDeliveryOrder(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['paymentProofUrl', 'paymentPhone', 'paymentStatus', 'updatedAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus'])
                || request.resource.data.paymentStatus == 'verificando')));

      // Los cobros y reservas requieren cancelación servidor, conservando su rastro.
      allow delete: if isAdmin() && !isTilopayOrder(resource.data) && !isCashOnDeliveryOrder(resource.data)
        && !resource.data.keys().hasAny(['inventoryReservation', 'fulfillment', 'discount']);

      match /items/{itemId} {
        allow read: if request.auth != null
          && (isAdmin() || ownsOrder(get(/databases/$(database)/documents/orders/$(orderId)).data));
        // El administrador conserva la edición de líneas históricas sin reserva.
        allow create: if isAdmin() && unlockedItems(getAfter(/databases/$(database)/documents/orders/$(orderId)).data)
          && validClientItem(request.resource.data);
        allow update: if isAdmin()
          && unlockedItems(getAfter(/databases/$(database)/documents/orders/$(orderId)).data)
          && validClientItem(request.resource.data);
        allow delete: if isAdmin()
          && unlockedItems(getAfter(/databases/$(database)/documents/orders/$(orderId)).data);
      }
    }

    // Registros de autoridad del servidor. No hay wildcard que los conceda.
    match /tilopayTx/{id} { allow read, write: if false; }
    match /tilopayReferences/{id} { allow read, write: if false; }
    match /tilopayCheckoutLocks/{id} { allow read, write: if false; }
    match /tilopayReconciliation/{id} { allow read, write: if false; }

    // --- CRM (admin lee todo, usuario puede crear/actualizar su propio contacto) ---
    match /crm_contacts/{contactId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        || (request.auth != null && request.auth.uid == contactId);
      allow delete: if isAdmin();

      match /interactions/{interactionId} {
        allow read, write: if isAdmin();
      }

      match /messages/{messageId} {
        allow read, write: if isAdmin();
      }
    }

    // --- Automatizaciones (solo admin) ---
    match /automations/{automationId} {
      allow read, write: if isAdmin();
    }

    // --- Zonas de envío (lectura pública, escritura admin) ---
    match /shipping_zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Sorteo: inscripción por enterGiveaway, con uid y número del servidor ---
    // El participante consulta únicamente su documento; la lista es privada.
    // Ningún navegador puede fabricar números, sobrescribir consentimientos
    // o borrar y volver a inscribirse. La creación es una transacción del servidor.
    match /giveawayEntries/{uid} {
      allow get: if (isOwner(uid)
          && request.auth.token.firebase.sign_in_provider != 'anonymous')
        || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /giveawayCounters/{campaignId} {
      allow read, write: if false;
    }

    // El estándar de ganancia es interno; no se publica en config ni products.
    match /admin_pricing/settings {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['version', 'markupPercent', 'roundingStep', 'localShippingCRC', 'internationalShippingCRC', 'updatedAt'])
        && request.resource.data.version == 2
        && request.resource.data.markupPercent is number
        && request.resource.data.markupPercent >= 0 && request.resource.data.markupPercent <= 1000
        && request.resource.data.roundingStep in [1, 100, 500, 1000]
        && request.resource.data.localShippingCRC is number
        && request.resource.data.localShippingCRC >= 0 && request.resource.data.localShippingCRC <= 1000000000
        && request.resource.data.internationalShippingCRC is number
        && request.resource.data.internationalShippingCRC >= 0 && request.resource.data.internationalShippingCRC <= 1000000000
        && request.resource.data.updatedAt == request.time;
    }

    match /admin_supplier_catalogs/{catalogId} {
      allow read: if isAdmin();
      allow write: if false; // Importación validada y atómica por callable.
    }
    match /admin_pricing_requests/{uid} { allow read, write: if false; }

    // --- Configuración (lectura pública, escritura admin) ---
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Logs de mensajes (solo admin) ---
    match /message_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
