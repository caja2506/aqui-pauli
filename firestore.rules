rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserRole() {
      return get(/databases/$(database)/documents/users_roles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // --- users_roles ---
    match /users_roles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'cliente';
      allow update, delete: if isAdmin();
    }

    // --- Catálogo público (lectura abierta) ---
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      match /variants/{variantId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /brands/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- Carrito (solo dueño) ---
    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // --- Pedidos ---
    // El estado de pago, montos e ids de pasarela SOLO los escribe el servidor
    // (Cloud Functions / Admin SDK, que ignora estas reglas) o un admin.
    // El dueño puede: crear su pedido (pendiente), leerlo y adjuntar el comprobante.
    // Tampoco puede escribir campos de dueño/pasarela (tilopay, paypal, customerUid ajeno) ni cambiar totales
    // o estados después de crear. tilopayTx/* (registro de transacciones) no tiene regla: solo el servidor.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.uid == request.auth.uid || resource.data.customerUid == request.auth.uid);

      allow create: if isAdmin()
        || (request.auth != null
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.paymentStatus == 'pendiente'
            && request.resource.data.status == 'pendiente_pago'
            && !request.resource.data.keys().hasAny([
              'paypal', 'tilopay', 'paymentAmount', 'paymentTransactionId', 'paymentDate',
              'reconciliationResult', 'reconciliationDetails', 'priceCorrectedByServer'
            ])
            // customerUid (campo de dueño) solo puede ser el propio usuario
            && (!request.resource.data.keys().hasAny(['customerUid'])
                || request.resource.data.customerUid == request.auth.uid));

      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.uid == request.auth.uid
            && resource.data.paymentStatus in ['pendiente', 'rechazado', 'verificando']
            // Los pedidos con tarjeta (Tilopay) los gestiona solo el servidor
            && resource.data.get('paymentMethod', '') != 'tilopay'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['paymentProofUrl', 'paymentPhone', 'paymentStatus', 'updatedAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus'])
                || request.resource.data.paymentStatus == 'verificando'));

      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read: if request.auth != null
          && (isAdmin() || get(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid);
        // Items solo se crean junto con el pedido propio, mientras no esté pagado
        allow create: if isAdmin()
          || (request.auth != null
              && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.uid == request.auth.uid
              && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.paymentStatus == 'pendiente'
              // no se agregan items a un pedido con un pago Tilopay ya iniciado
              && !('tilopay' in getAfter(/databases/$(database)/documents/orders/$(orderId)).data));
        allow update, delete: if isAdmin();
      }
    }

    // --- CRM (admin lee todo, usuario puede crear/actualizar su propio contacto) ---
    match /crm_contacts/{contactId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        || (request.auth != null && request.auth.uid == contactId);
      allow delete: if isAdmin();

      match /interactions/{interactionId} {
        allow read, write: if isAdmin();
      }

      match /messages/{messageId} {
        allow read, write: if isAdmin();
      }
    }

    // --- Automatizaciones (solo admin) ---
    match /automations/{automationId} {
      allow read, write: if isAdmin();
    }

    // --- Zonas de envío (lectura pública, escritura admin) ---
    match /shipping_zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Configuración (lectura pública, escritura admin) ---
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Logs de mensajes (solo admin) ---
    match /message_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
